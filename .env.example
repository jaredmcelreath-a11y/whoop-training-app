WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=http://localhost:3000/auth/whoop/callback
# bcrypt/scrypt hash of the app password
APP_PASSWORD_HASH=replace-me
# at least 32 characters
SESSION_SECRET=replace-with-a-random-string-of-32-or-more-chars
# base64 of 32 random bytes: openssl rand -base64 32
TOKEN_ENC_KEY=replace-with-base64-32-bytes
CRON_SECRET=replace-me
# optional
# DATABASE_URL=postgres://user:pass@host/db
OWNER_TZ=America/Chicago
